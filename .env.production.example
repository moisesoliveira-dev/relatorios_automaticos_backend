# =============================================================================
# Produção — configure no Railway / servidor (NÃO commitar valores reais)
# =============================================================================

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend.example.com

# Railway injeta DATABASE_URL automaticamente via plugin Postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Banco separado do rodízio e tarefas automáticas (obrigatório em produção)
# Use a mesma URL do projeto criar_tarefas_automaticas (DATABASE_PUBLIC_URL)
ROTATION_DATABASE_URL=postgresql://user:pass@host:5432/rotation_db

# Jobs de tarefas automáticas (criar_tarefas_automaticas integrado)
JOBS_ENABLED=true
TASK_DIAS_CHECAGEM_MEDIDA=2
TASK_DIAS_REVISAO_PROJETO=2
TASK_DIAS_PROJETO_EXECUTIVO=2
TASK_DIAS_APROVACAO_EXECUTIVO=2
TASK_DIAS_ENVIO_CLIENTE=2

# Pontta
PONTTA_AUTH_URL=https://api.pontta.com/api/authenticate
PONTTA_API_URL=https://app.pontta.com/api
PONTTA_API_KEY=
PONTTA_BUSINESS_UNIT_ID=
PONTTA_EMAIL=
PONTTA_PASSWORD=

# GOSAC (obrigatório para Grupos/Rodízio/Webhook — app sobe sem, mas essas rotas retornam 503)
GOSAC_BASE_URL=https://cmmodulados.gosac.com.br
GOSAC_API_KEY=

# Segurança — mínimo 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
