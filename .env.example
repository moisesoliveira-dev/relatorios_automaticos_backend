# Configurações da API Pontta
PONTTA_AUTH_URL=https://api.pontta.com/api/authenticate
PONTTA_API_URL=https://app.pontta.com/api
PONTTA_API_KEY=your_pontta_api_key

# Credenciais Pontta (podem ser sobrescritas pelo frontend)
PONTTA_EMAIL=seu_email_pontta@example.com
PONTTA_PASSWORD=***REMOVIDO***

# Configurações de Email (SMTP) - Configure com seu servidor SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email_smtp@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=seu_email_smtp@example.com

# Porta do servidor
PORT=3000

# Banco de Dados principal do app
# Em produção no Railway, DATABASE_URL já vem do plugin Postgres.
# Localmente use DB_* (ou DATABASE_URL do banco do app).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=relatorios_db
# DATABASE_URL=

# Banco SEPARADO do rodízio (tb_rotation) — diferente do DATABASE_URL do app
ROTATION_DATABASE_URL=postgresql://postgres:your_railway_db_password@crossover.proxy.rlwy.net:39393/railway

# JWT
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_123456
JWT_EXPIRES_IN=7d

# Encryption Key (32 caracteres para AES-256)
ENCRYPTION_KEY=sua-chave-criptografia-32-chars
