# Variáveis de ambiente — CMM System Backend
#
# Use arquivos separados por ambiente:
#   cp .env.development.example .env.development   # desenvolvimento local
#   cp .env.production.example  .env.production    # produção (Railway)
#
# Ordem de carregamento (ver src/load-env.ts):
#   .env.{NODE_ENV}.local → .env.{NODE_ENV} → .env.local → .env
#
# NUNCA commite arquivos .env com credenciais reais.

# Desenvolvimento rápido (legado — prefira .env.development)
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=relatorios_db

PONTTA_AUTH_URL=https://api.pontta.com/api/authenticate
PONTTA_API_URL=https://app.pontta.com/api
PONTTA_API_KEY=your_pontta_api_key
PONTTA_BUSINESS_UNIT_ID=your_business_unit_uuid
PONTTA_EMAIL=your_pontta_email
PONTTA_PASSWORD=your_pontta_password

GOSAC_BASE_URL=https://your-instance.gosac.com.br
GOSAC_API_KEY=your_gosac_integration_key

JWT_SECRET=dev-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=dev-encryption-key-32-chars!!

# ROTATION_DATABASE_URL=  # opcional em dev, obrigatório em produção

# ---- Segurança (novas variáveis) ----
# Segredo do webhook do GOSAC. OBRIGATÓRIO em produção (sem ele o webhook é recusado).
# Cadastre a URL no GOSAC como: https://SEU-BACKEND/api/gosac/webhook?token=<GOSAC_WEBHOOK_SECRET>
# Gere com: openssl rand -hex 32
GOSAC_WEBHOOK_SECRET=
# Hosts extras (separados por vírgula) de onde o webhook pode baixar mídia, além do host do GOSAC_BASE_URL
GOSAC_MEDIA_ALLOWED_HOSTS=
# Se definido, o cadastro do primeiro usuário master exige este token
MASTER_SETUP_TOKEN=
# true = valida o certificado TLS do banco (use quando o banco tiver certificado válido)
DB_SSL_REJECT_UNAUTHORIZED=false
# true = cria/altera tabelas sozinho (SÓ em desenvolvimento local; ignorado em produção)
DB_SYNCHRONIZE=false
# Duração do login. Padrão: 12h
JWT_EXPIRES_IN=12h

# ---- Chatbot com IA (OpenAI) ----
# Liga o chatbot. Antes de ligar, aponte o webhook do GOSAC para este backend e DESLIGUE o fluxo CMM no n8n (senão o cliente recebe respostas duplicadas).
CHATBOT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelos de raciocínio (o-series/gpt-5) não aceitam temperature: deixe vazio para omitir.
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_MS=12000
# false = chatbot só com regras fixas (sem chamar a OpenAI)
CHATBOT_AI_ENABLED=true
# Pontta (negócio + agenda de medição): DESLIGADO por enquanto. Sem ele, quem quer agendar vai para um atendente humano.
CHATBOT_PONTTA_ENABLED=false
CHATBOT_MEASURE_OWNER_ID=
# Funil comercial do CMSYS (API de integração): cria o lead no encaminhamento. Chave por ambiente.
CHATBOT_CRM_ENABLED=false
CHATBOT_CRM_FLUXO=2.2
CRM_API_URL=
CRM_API_KEY=
# Google Drive: pasta raiz "01 - VENDAS E PROJETOS" (ano/mês/ANDAMENTO/<ticket> - <nome>)
CHATBOT_DRIVE_ROOT_FOLDER_ID=
# Se o rodízio não estiver disponível, o ticket vai para este atendente/fila
CHATBOT_FALLBACK_GOSAC_USER_ID=
CHATBOT_FALLBACK_GOSAC_QUEUE_ID=
CHATBOT_DEBOUNCE_MS=3000
CHATBOT_MAX_INVALID=3
CHATBOT_AI_DAILY_LIMIT=40
CHATBOT_HUMAN_IDLE_MINUTES=60
# Mensagens com voz natural (agente Redator). false = sempre os textos padrão.
CHATBOT_HUMANIZE=true
# Pausa de "digitando" antes de cada bolha
CHATBOT_TYPING_DELAY=true
CHATBOT_WRITER_DAILY_LIMIT=60
CHATBOT_MAX_OFF_TOPIC=3
# Opcional: modelo diferente por agente (OPENAI_MODEL_SCOPE, _INTERPRETER, _FAQ, _VERIFIER, _WRITER)
# OPENAI_MODEL_WRITER=
# SSL na conexão com o banco, independente do NODE_ENV (vazio = produção liga). Mantenha false até testar no seu Postgres.
# DB_SSL=false
