# Variáveis do deploy na VPS. Preencha no gerenciador do Hostinger (ou num arquivo .env ao lado do compose).
# NUNCA commite os valores reais.

# Domínio apontado (registro A) para o IP da VPS
DOMINIO=sistema.seudominio.com.br

DB_USERNAME=relatorios
DB_PASSWORD=troque-por-uma-senha-forte
DB_DATABASE=relatorios

# Gere cada um com: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
GOSAC_WEBHOOK_SECRET=
JWT_EXPIRES_IN=12h

# Copie os valores abaixo das variáveis do backend no Railway
GOSAC_BASE_URL=
GOSAC_API_KEY=
PONTTA_API_URL=
PONTTA_AUTH_URL=
PONTTA_API_KEY=
PONTTA_EMAIL=
PONTTA_PASSWORD=
PONTTA_BUSINESS_UNIT_ID=
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_DELIVERY_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
JOBS_ENABLED=true
TASK_DIAS_APROVACAO_EXECUTIVO=
TASK_DIAS_CHECAGEM_MEDIDA=
TASK_DIAS_ENVIO_CLIENTE=
TASK_DIAS_PROJETO_EXECUTIVO=
TASK_DIAS_REVISAO_PROJETO=
