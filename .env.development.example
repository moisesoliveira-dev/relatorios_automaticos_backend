# =============================================================================
# Desenvolvimento local — copie para .env.development e preencha os valores
# cp .env.development.example .env.development
# =============================================================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Banco local (Docker Compose ou Postgres instalado)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=relatorios_db
# DATABASE_URL=

# Rodízio (opcional em dev — deixe vazio para desabilitar o módulo localmente)
# ROTATION_DATABASE_URL=

# Pontta
PONTTA_AUTH_URL=https://api.pontta.com/api/authenticate
PONTTA_API_URL=https://app.pontta.com/api
PONTTA_API_KEY=your_pontta_api_key
PONTTA_BUSINESS_UNIT_ID=your_business_unit_uuid
PONTTA_EMAIL=your_pontta_email
PONTTA_PASSWORD=your_pontta_password

# GOSAC
GOSAC_BASE_URL=https://your-instance.gosac.com.br
GOSAC_API_KEY=your_gosac_integration_key

# Segurança (use valores diferentes em produção)
JWT_SECRET=dev-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=dev-encryption-key-32-chars!!

# SMTP (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
