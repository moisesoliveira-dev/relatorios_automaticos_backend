# =============================================================================
# Desenvolvimento local — copie para .env.development e preencha os valores
# cp .env.development.example .env.development
# =============================================================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Banco local (Docker Compose ou Postgres instalado)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=relatorios_db
# DATABASE_URL=

# Rodízio (opcional em dev — deixe vazio para desabilitar o módulo localmente)
# ROTATION_DATABASE_URL=


# GOSAC
GOSAC_BASE_URL=https://your-instance.gosac.com.br
GOSAC_API_KEY=your_gosac_integration_key

# Segurança (use valores diferentes em produção)
JWT_SECRET=dev-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=dev-encryption-key-32-chars!!

# SMTP (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cria/altera tabelas automaticamente (SÓ em desenvolvimento local)
DB_SYNCHRONIZE=true

# ---- Chatbot com IA (OpenAI) — veja docs/chatbot-verador/CHATBOT-IA.md ----
# Modo teste: só os números da lista (separados por vírgula) são atendidos pelo chatbot
CHATBOT_TEST_MODE=false
CHATBOT_TEST_NUMBERS=
CHATBOT_ENABLED=false
# Funil comercial do CMSYS (homologação: https://homolog.servidorcm.cloud)
CHATBOT_CRM_ENABLED=false
CHATBOT_CRM_FLUXO=2.2
CRM_API_URL=https://homolog.servidorcm.cloud
CRM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOSAC_WEBHOOK_SECRET=
